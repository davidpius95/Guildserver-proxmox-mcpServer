# Guild-A Node Post-Installation Configuration
# Copy to .env and fill in your actual values (never commit .env)

# Tailscale reusable auth key (get from Tailscale admin console → Settings → Keys)
TAILSCALE_AUTH_KEY=tskey-example-only-replace-with-real-key

# Optional: cluster name (auto-detected from pvecm status, but can override)
CLUSTER_NAME=guild-a

# Optional: Proxmox root password (only needed for initial setup, usually not used)
# PROXMOX_ROOT_PASSWORD=your-password-here
